<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.curiodesk</groupId>
        <artifactId>linkedin-scraper</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>scraper-frontend</artifactId>
    <packaging>pom</packaging>
    <name>scraper-frontend</name>
    <description>LinkedIn Scraper Flutter Frontend</description>

    <build>
        <plugins>
            <!-- Delegates build/test/clean lifecycle phases to Flutter CLI -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <!-- flutter pub get on initialize -->
                    <execution>
                        <id>flutter-pub-get</id>
                        <phase>initialize</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>flutter</executable>
                            <arguments>
                                <argument>pub</argument>
                                <argument>get</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- flutter build web on package -->
                    <execution>
                        <id>flutter-build</id>
                        <phase>package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>flutter</executable>
                            <arguments>
                                <argument>build</argument>
                                <argument>web</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- flutter test on test -->
                    <execution>
                        <id>flutter-test</id>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>flutter</executable>
                            <arguments>
                                <argument>test</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
